# ── Terminal emulator ──────────────────────────────────────────────────────
# Its own settings. The platform never reads this file.

# The one account that can use the emulator. Leave the password empty and one
# is generated on first boot, printed once in the logs, and kept (hashed) in
# the emulator's database. Setting it here always wins over the generated one.
EMULATOR_SUPER_ADMIN_EMAIL=superadmin@emulator.local
EMULATOR_SUPER_ADMIN_PASSWORD=
# Empty = generated once and kept in the emulator's database.
EMULATOR_JWT_SECRET=
EMULATOR_SESSION_TTL=12h

# Every emulated uid starts with this, so one can never be a real terminal's.
EMULATOR_UID_PREFIX=EMU-

# Local runs only (docker sets these itself).
EMULATOR_PORT=8095
EMULATOR_DB_PATH=./data/emulator.db
# Host port when run with docker compose.
EMULATOR_HOST_PORT=8095

# ── Broker ─────────────────────────────────────────────────────────────────
# Must be the SAME broker and root topic as the listener (MQTT_URL /
# MQTT_ROOT_TOPIC in the platform's .env), or the two never hear each other.
# mqtt://host.docker.internal = the Mosquitto on this machine, from docker.
# Running the emulator on another machine? Use the server's address.
MQTT_URL=mqtt://host.docker.internal
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_ROOT_TOPIC=Pay
MQTT_CLIENT_ID_PREFIX=emu
MQTT_QOS=1
