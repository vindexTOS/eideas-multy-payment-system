# Root compose env: shared by the server container.
# Copy to .env and fill in. The client needs nothing here - it talks to
# /api, which nginx proxies to the server service.

# ── Ports on the host ──────────────────────────────────────────────────────
CLIENT_PORT=8080
SERVER_PORT=4000

# ── Database (OUTSIDE docker - dedicated Postgres) ────────────────────────
# host.docker.internal = Postgres running on this machine.
# In production put the real hostname or IP here.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=eideas_payments
DB_SCHEMA=public
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=false

# ── Auth (change both before going live) ──────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change-this-to-another-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

# ── MQTT ───────────────────────────────────────────────────────────────────
MQTT_ENABLED=true
MQTT_URL=mqtt://broker.hivemq.com
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID_PREFIX=eideas-pay
MQTT_QOS=1
MQTT_ROOT_TOPIC=Pay
MQTT_LOG_RAW=true
# Binary payment frames are only booked once the device protocol is
# confirmed; JSON frames work today.
MQTT_BINARY_PAYMENTS=false
MQTT_PAYMENT_COMMAND=4
MQTT_AMOUNT_DIVISOR=100

# ── CORS (only needed when the client is served from another origin) ──────
CORS_ORIGINS=*

# ── First admin, created only when no admin exists ────────────────────────
# Leave SEED_ADMIN_PASSWORD empty and the server generates a random one and
# prints it once in the logs. Never commit a real password here.
SEED_ADMIN_EMAIL=admin@eideas.io
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=System Administrator
