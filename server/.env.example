# ── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ── Database (lives OUTSIDE docker: dedicated Postgres host) ───────────────
# From inside docker use host.docker.internal (mapped to host-gateway in
# docker-compose.yml); from a local `npm run start:dev` use the real host.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=eideas_payments
DB_SCHEMA=public
# Keep true while the schema is still moving; switch to false + migrations
# before production.
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=false

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change-this-to-another-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

# ── MQTT ───────────────────────────────────────────────────────────────────
MQTT_ENABLED=true
# Our own Mosquitto on the server. As with DB_HOST: host.docker.internal
# from inside docker, the server's address from a local `npm run start:dev`.
MQTT_URL=mqtt://host.docker.internal
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID_PREFIX=eideas-pay
MQTT_QOS=1
# Root of every topic: {root}/{deviceUid}/events/{event}
MQTT_ROOT_TOPIC=Pay
MQTT_LOG_RAW=true
# Terminals report amounts in tetri; 100 tetri = 1 GEL.
MQTT_AMOUNT_DIVISOR=100

# ── First admin (created only when no admin exists) ────────────────────────
# Leave SEED_ADMIN_PASSWORD empty and the server generates a random one and
# prints it once in the logs. Never commit a real password here.
SEED_ADMIN_EMAIL=admin@eideas.io
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=System Administrator
